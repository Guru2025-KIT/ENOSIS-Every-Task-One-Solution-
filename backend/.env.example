# Copy this file to .env and fill in real values. .env should be in
# .gitignore and NEVER committed — this .env.example (with placeholder
# values) is what's safe to commit instead.

# For local dev without Docker, you can leave DATABASE_URL unset entirely
# and it'll default to a local SQLite file (see app/core/config.py).
# When running via docker-compose, this gets overridden automatically to
# point at the MySQL container — you don't need to set it here for Docker.
DATABASE_URL=mysql+pymysql://enosis_user:enosis_pass@localhost:3306/enosis_db

# Generate a real random string for this, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-this-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

APP_NAME=ENOSIS Backend
ENV=development
COLLEGE_NAME=Your College Name Here
